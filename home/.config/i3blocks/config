command=/usr/share/i3blocks/$BLOCK_NAME
separator_block_width=15
markup=none

[volume]
label=VOL
instance=Master
interval=once
signal=10

[audio-device]
label=AUDIO
command=~/bin/player i3
interval=10

[light]
label=LIGHT
command=~/bin/light
interval=10

[memory]
label=MEM
separator=false
interval=30

[memory]
label=SWAP
instance=swap
separator=false
interval=30

[load_average]
label=LOAD
interval=10
separator=false

[temperature]
label=TEMP
interval=10
separator=false

[disk]
label=DISK
interval=30

[wifi]
command=~/bin/network
label=NET
interval=10
separator=false

[bandwidth]
interval=5

[battery]
command=~/bin/battery
label=BAT
interval=30

[time]
command=~/bin/multidate
interval=5

profile work1 {
    output eDP-1 disable
    output DP-1 enable position 0,0
    exec swaymsg "focus output DP-1"
}
profile work2 {
    output eDP-1 disable
    output "Dell Inc. DELL U2415 7MT017BA1GLL" enable position 0,0
    exec swaymsg "focus output DP-2"
}

profile home {
    output eDP-1 disable
    output DP-2 mode 2560x1440 position 0,0
    exec swaymsg "focus output HDMI-A-1"
}

profile out1 {
    output eDP-1 position 320,1440
    output HDMI-A-1 enable position 1920,0
    exec swaymsg "focus output HDMI-A-1"
}

profile laptop {
    output eDP-1 enable
}

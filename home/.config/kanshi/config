profile home {
    output HDMI-A-1 mode 2560x1440 position 0,0
    output eDP-1 disable
    exec swaymsg "focus output HDMI-A-1"
}

profile work {
    output eDP-1 disable
    output DP-2 enable position 0,0
    exec swaymsg "focus output DP-2"
}

profile out1 {
    output eDP-1 position 320,1440
    output HDMI-A-1 enable position 1920,0
    exec swaymsg "focus output HDMI-A-1"
}

profile laptop {
    output eDP-1 enable
}

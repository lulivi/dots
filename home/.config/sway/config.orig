-bar {
-    position top
-    status_command i3blocks -vvv 2>/tmp/i3blocks.err | tee /tmp/i3blocks.out
-
-    colors {
-        statusline #ffffff
-        background #323232
-        inactive_workspace #323232 #323232 #5c5c5c
-    }
-}

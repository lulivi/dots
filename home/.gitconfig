[core]
    editor = vim
    excludesfile = ~/config/git/gitignore
    # pager = delta
    autocrlf = input

[interactive]
#     diffFilter = delta

[commit]
    template = ~/config/git/gitcommit

[pull]
    rebase = false
    ff = only

; [push]
;     autoSetupRemote = true

[init]
    defaultBranch = main

[alias]
    p   = pull
    pr  = pull --rebase
    b   = branch
    c   = clone
    cr  = clone --recurse-submodules
    s   = status
    ss  = status -s
    d   = diff
    dc  = diff --cached
    ch  = checkout
    chb = checkout -b
    l   = log --oneline -n 20
    lt  = tag -l --sort=-creatordate --format='%(creatordate:short): %(refname:short)'
    ll  = log --oneline
    superclean = clean -dfx

[delta]
    side-by-side = true
    line-numbers = true
    plus-style = green
    plus-emph-style = green bold 22
    minus-style = red
    minus-emph-style = red bold 52

[diff]
    tool = vimdiff

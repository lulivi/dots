"""Check current xrandr information and reconfigure the screens in accordingly."""
import argparse
import logging
import re
import subprocess
import sys
import tempfile
import time

from pathlib import Path
from typing import List, NamedTuple

from rofiwrapper import select_option

LOG_FILE = "/tmp/reconfigure_screens.log"
logging.basicConfig(
    filename=LOG_FILE,
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
logger = logging.getLogger(__name__)

SCREEN_LAYOUT_DIR = Path().home().joinpath(".screenlayout")
RELOAD_WM_EXECUTABLE = Path().home().joinpath("bin", "reload_wm.sh").resolve()
LOG_PREFIX = "[Reconfigure Screens]"
MULTI_MONITORCACHE_FILE: Path = Path(tempfile.gettempdir()).joinpath("reconfigure-screens-cache")


class ScreenState(NamedTuple):
    name: str
    resolution: str
    in_use: bool


def main():
    args = parse_args()
    configurations: List[str] = [
        "1",
        "home1",
        "home2",
        "office1",
        "office2",
        "office3",
    ]

    if args.configuration and args.configuration in configurations:
        log_message(f"Using provided configuration: {args.configuration}")
        select_display(args.configuration)
        return

    xrandr_output = subprocess.run(
        ["xrandr"], stdout=subprocess.PIPE, universal_newlines=True
    ).stdout
    screens = [
        ScreenState(match[0], match[1], bool(match[2]))
        for match in re.findall(
            pattern=r"^([\w-]+) connected.*\n.\s+(\d+x\d+)\s+\d+.\d+\s*(\*)?\+",
            string=xrandr_output,
            flags=re.MULTILINE,
        )
    ]
    if not screens:
        log_message("ERROR: No screens found", logging.error)
        sys.exit(1)

    if len(screens) == 1:
        log_message("There is only one screen, selecting 1 screen mode")
        select_display("1")
        return

    if MULTI_MONITORCACHE_FILE.exists():
        cached_configuration = MULTI_MONITORCACHE_FILE.read_text().strip()
        logger.info(f"Found cached configuration: {cached_configuration}")
        if cached_configuration in configurations:
            log_message(
                "Using cached configuration in"
                f" {MULTI_MONITORCACHE_FILE} ({cached_configuration}). Delete to select a"
                " different configuration",
            )
            select_display(cached_configuration)
            return

    auto_selected_configuration = ""
    if len(screens) == 2:
        external_screen: ScreenState = list(
            filter(lambda screen: screen.name != "eDP-1", screens)
        ).pop()
        auto_selected_configuration = "home1"
        log_message(
            f"Auto selected configuration based on 2 screens: {auto_selected_configuration}"
        )
        if external_screen.resolution == "1920x1200":
            auto_selected_configuration = "office1"
            log_message(
                f"Auto selected configuration based on external screen resolution 1920x1200: {auto_selected_configuration}"
            )

    connected_displays = ", ".join(f"{screen.name}:{screen.resolution}" for screen in screens)
    log_message(f"Connected displays: {connected_displays}")

    selected_configuration: str = (
        auto_selected_configuration
        or configurations[
            select_option(
                prompt="Select configuration",
                options=configurations,
                message=connected_displays,
            )
        ]
    )
    log_message(f"Selected configuration: {selected_configuration}")
    select_display(selected_configuration, cache=True)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--configuration")
    return parser.parse_args()


def select_display(script: str, cache: bool = False):
    subprocess.run([str(SCREEN_LAYOUT_DIR.joinpath(f"{script}.sh"))])
    if not RELOAD_WM_EXECUTABLE.exists():
        log_message(f"The file {RELOAD_WM_EXECUTABLE} does not exist. Existing.")
        sys.exit(1)
    time.sleep(1)
    subprocess.run([str(RELOAD_WM_EXECUTABLE)])

    if cache:
        MULTI_MONITORCACHE_FILE.touch()
        MULTI_MONITORCACHE_FILE.write_text(script)


def log_message(message: str, log_function=logging.info):
    log_function(message)
    send_notification(message)


def send_notification(message: str = ""):
    subprocess.run(["notify-send", "Reconfigure screens", message])


if __name__ == "__main__":
    main()
